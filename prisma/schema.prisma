generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  coverImage  String?
  tags        String[] @default([])
  published   Boolean  @default(false)
  publishedAt DateTime?
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  comments    Comment[]
  dailyViews  DailyPostView[]
  aiDocuments AiDocument[]

  @@index([published, publishedAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  author    String
  email     String?
  content   String
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, approved, createdAt])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  success    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([path, createdAt])
}

model DailyPostView {
  id        String   @id @default(cuid())
  postId    String
  date      DateTime
  count     Int      @default(0)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, date])
  @@index([date])
}

model AiDocument {
  id        String   @id @default(cuid())
  postId    String
  chunk     Int
  content   String
  metadata  Json?
  embedding Json?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, chunk])
  @@index([postId])
}

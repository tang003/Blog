{
  "name": "blog-silas-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "ai:index": "node ops/rebuild-ai-index.mjs",
    "backup": "powershell -ExecutionPolicy Bypass -File ./ops/backup.ps1",
    "restore": "powershell -ExecutionPolicy Bypass -File ./ops/restore.ps1",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@mdxeditor/editor": "^4.1.0",
    "@prisma/client": "^6.19.3",
    "next": "^16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "js-yaml": "4.3.0",
    "postcss": "8.5.15",
    "sharp": "0.35.3"
  }
}
